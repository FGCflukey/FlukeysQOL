---------------------------------------------------------
-- Flukey's Dynamic Trunk Capacity System (Ceiling Model)
-- Build 42.13.x
---------------------------------------------------------

if not FlukeysDynamicTrunks then FlukeysDynamicTrunks = {} end

---------------------------------------------------------
-- CONFIG
---------------------------------------------------------

local CFG = {}

-- Vehicle category mapping (script name → category)
CFG.VehicleCategories = {
    ["Base.SmallCar"]        = "SmallCar",
    ["Base.CarNormal"]       = "Sedan",
    ["Base.ModernCar"]       = "Sedan",
    ["Base.SportsCar"]       = "Sports",
    ["Base.CarStationWagon"] = "Sedan",
    ["Base.PickUpTruck"]     = "Pickup",
    ["Base.PickUpTruckLights"]= "Pickup",
    ["Base.Van"]             = "Van",
    ["Base.VanSeats"]        = "VanSeats",
    ["Base.StepVan"]         = "StepVan",
    ["Base.Trailer"]         = "Trailer",
}

-- Category maximum capacities (your values)
CFG.CategoryMaxCapacity = {
    SmallCar = 150,
    Sedan    = 300,
    Sports   = 300,
    Van      = 800,
    VanSeats = 400,
    Pickup   = 800,
    StepVan  = 900,
    Trailer  = 1000,
}

-- Skill bonuses
CFG.MechanicsPerLevelBonus = 4

-- Trait bonuses
CFG.TraitBonuses = {
    ["Organized"]    = 8,
    ["Handy"]        = 4,
    ["Mechanics"]    = 6,   -- custom trait example
    ["Disorganized"] = -8,
}

-- Condition multiplier (affects bonuses only)
CFG.MinConditionMultiplier = 0.4

-- Rare vehicle modifiers
CFG.RareVehicles = {
    ["Base.PickUpTruckMccoy"] = { flatBonus = 20, multiplier = 1.1 },
    ["Base.VanAmbulance"]     = { flatBonus = 10, multiplier = 1.05 },
}

-- Update throttling
CFG.UpdateIntervalTicks = 30

---------------------------------------------------------
-- HELPERS
---------------------------------------------------------

local function getVehicleScriptName(vehicle)
    local script = vehicle and vehicle:getScript()
    return script and (script:getFullName() or script:getName()) or nil
end

local function getVehicleCategory(vehicle)
    local scriptName = getVehicleScriptName(vehicle)
    return scriptName and CFG.VehicleCategories[scriptName] or nil
end

local function getCategoryMax(vehicle)
    local category = getVehicleCategory(vehicle)
    return category and CFG.CategoryMaxCapacity[category] or nil
end

local function getVanillaTrunkCapacity(vehicle)
    local part = vehicle and vehicle:getPartById("Trunk")
    if not part then return nil end
    local container = part:getItemContainer()
    return container and container:getCapacity() or nil
end

local function getMechanicsBonus(player)
    return player:getPerkLevel(Perks.Mechanics) * CFG.MechanicsPerLevelBonus
end

local function getTraitBonus(player)
    local total = 0
    for trait, value in pairs(CFG.TraitBonuses) do
        if player:HasTrait(trait) then
            total = total + value
        end
    end
    return total
end

local function getConditionMultiplier(vehicle)
    local cond = math.max(0, math.min(100, vehicle:getOverallCondition()))
    local t = cond / 100
    return CFG.MinConditionMultiplier + (1 - CFG.MinConditionMultiplier) * t
end

local function applyRareModifiers(vehicle, bonus)
    local scriptName = getVehicleScriptName(vehicle)
    local cfg = scriptName and CFG.RareVehicles[scriptName]
    if not cfg then return bonus end

    local result = bonus
    if cfg.flatBonus then result = result + cfg.flatBonus end
    if cfg.multiplier then result = result * cfg.multiplier end
    return result
end

---------------------------------------------------------
-- CORE CALCULATION
---------------------------------------------------------

function FlukeysDynamicTrunks.computeCapacity(player, vehicle)
    local vanilla = getVanillaTrunkCapacity(vehicle)
    local maxCap = getCategoryMax(vehicle)
    if not vanilla or not maxCap then return nil end

    local mechBonus = getMechanicsBonus(player)
    local traitBonus = getTraitBonus(player)
    local condMult = getConditionMultiplier(vehicle)

    local bonus = (mechBonus + traitBonus) * condMult
    bonus = applyRareModifiers(vehicle, bonus)

    local final = vanilla + bonus
    if final > maxCap then final = maxCap end

    return math.floor(final + 0.5)
end

function FlukeysDynamicTrunks.applyToVehicle(player, vehicle)
    local part = vehicle and vehicle:getPartById("Trunk")
    if not part then return end

    local container = part:getItemContainer()
    if not container then return end

    local newCap = FlukeysDynamicTrunks.computeCapacity(player, vehicle)
    if not newCap then return end

    if container:getCapacity() ~= newCap then
        container:setCapacity(newCap)
        vehicle:getModData().FlukeysDynamicTrunkCap = newCap
    end
end

---------------------------------------------------------
-- EVENT HOOKS
---------------------------------------------------------

local function onPlayerUpdate(player)
    if not player or player:isDead() then return end

    local md = player:getModData()
    md._FDT_tick = (md._FDT_tick or 0) + 1
    if md._FDT_tick % CFG.UpdateIntervalTicks ~= 0 then return end

    local vehicle = player:getVehicle()
    if not vehicle then return end

    FlukeysDynamicTrunks.applyToVehicle(player, vehicle)
end

Events.OnPlayerUpdate.Add(onPlayerUpdate)

local function onEnterVehicle(player)
    local vehicle = player and player:getVehicle()
    if vehicle then
        FlukeysDynamicTrunks.applyToVehicle(player, vehicle)
    end
end

Events.OnEnterVehicle.Add(onEnterVehicle)