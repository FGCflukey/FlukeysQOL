-- ============================================================
--  APPLY TRUNK-ONLY OVERRIDE TO A SINGLE VEHICLE
-- ============================================================
local function ApplyTrunkOverride(v)
    if not v or v:isRemovedFromWorld() then return end

    local script = v:getScript()
    if not script then return end

    local fullName = script:getFullName()
    local cfg = VehicleOverrides[fullName]
    if not cfg then return end

    for j = 0, v:getPartCount() - 1 do
        local p = v:getPartByIndex(j)
        if p then
            local c = p:getItemContainer()
            if c then
                local id = p:getId()
                local newCap = cfg[id]

                if DEBUG then
                    print("[TrunkOverride DEBUG] " .. fullName ..
                          " part ID=" .. tostring(id) ..
                          " type=" .. tostring(c:getType()))
                end

                if newCap then
                    c:setCapacity(newCap)
                    print("[TrunkOverride] Set " .. fullName ..
                          " container " .. id ..
                          " to " .. newCap)
                end
            end
        end
    end
end

-- ============================================================
--  CATCH BRAND-NEW VEHICLES THE MOMENT THEY SPAWN
-- ============================================================
Events.OnSpawnVehicleEnd.Add(ApplyTrunkOverride)

-- ============================================================
--  CATCH VEHICLES THE MOMENT SOMEONE GETS IN
-- ============================================================
local function OnEnterVehicleHandler(character)
    if not character then return end
    local v = character:getVehicle()
    if not v then return end

    local ok, err = pcall(ApplyTrunkOverride, v)
    if not ok and DEBUG then
        print("[TrunkOverride DEBUG] ApplyTrunkOverride failed on enter: " .. tostring(err))
    end
end
Events.OnEnterVehicle.Add(OnEnterVehicleHandler)

-- ============================================================
--  NOTE ON WORLD-SWEEP
-- ============================================================
-- A periodic full-world sweep (via cell:getVehicles()) was tried here to
-- catch vehicles that already existed in the world and are never spawned
-- fresh or entered by the player. It was removed: cell:getVehicles():get(i)
-- is not a valid call in this game version/build (fails on every index,
-- not just out-of-range ones), so there was no safe way to iterate it.
--
-- In practice this isn't a real gap: OnSpawnVehicleEnd covers new spawns,
-- and OnEnterVehicle applies the override the moment a player gets into
-- any vehicle, including ones that already existed in the world. That
-- covers every vehicle a player will actually use.
